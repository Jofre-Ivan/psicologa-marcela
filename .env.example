# =============================================================================
# CONFIGURACIÓN DEL SISTEMA - NO COMPARTIR NI SUBIR A GIT
# =============================================================================
# Generá las claves con: npm run generate-key
# =============================================================================

# ENTORNO
# -------
NODE_ENV=production
PUERTO=3000
URL_BASE=https://tudominio.com

# BASE DE DATOS
# -------------
DB_PATH=./datos.db

# PRECIO DEL SERVICIO (ARS por sesión)
# ------------------------------------
# Se aplica automáticamente en cada arranque (ej: 35000)
SERVICIO_PRECIO=

# CIFRADO AES-256-GCM (Datos sensibles de pacientes)
# --------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# SESIÓN
# ------
SESSION_SECRET=cambiar-por-clave-larga-aleatoria
SESSION_TIMEOUT_MIN=30

# MERCADO PAGO
# ------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# PAYPAL
# -----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# TWILIO (OTP por SMS)
# --------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# TELEGRAM
# --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GOOGLE CALENDAR
# ---------------
# 1) console.cloud.google.com -> proyecto -> habilitar "Google Calendar API"
# 2) Pantalla de consentimiento OAuth (External, agregá tu Gmail como test user)
# 3) Credenciales OAuth 2.0 tipo "Web app" con redirect:
#    http://localhost:3001/oauth2callback
# 4) GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET de esas credenciales
# 5) Ejecutá: node scripts/google-token.js (autorizá con el Gmail de la profesional)
#    -> el script escribe GOOGLE_REFRESH_TOKEN en .env.local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# CLOUDFLARE TURNSTILE
# --------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ADMIN (Primer usuario - cambiar al iniciar)
# --------------------------------------------
ADMIN_USER=marcela
ADMIN_TOTP_SECRET=

# LOGGING
# -------
LOG_LEVEL=info
AUDIT_LOG_PATH=./logs/audit.log
ERROR_LOG_PATH=./logs/error.log
