{
  "name": "psicologa-marcela",
  "version": "2.0.0",
  "description": "Sitio web seguro para la Lic. Marcela Rolón - Psicología Clínica Gestalt. Sistema de turnos con pagos online (Mercado Pago + PayPal), verificación OTP y cumplimiento Ley 25.326.",
  "main": "servidor/index.js",
  "scripts": {
    "start": "node servidor/index.js",
    "dev": "NODE_ENV=development node servidor/index.js",
    "backup": "bash scripts/backup.sh",
    "audit": "npm audit && bash scripts/audit.sh",
    "generate-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "keywords": [
    "psicologia",
    "gestalt",
    "turnos",
    "pagos",
    "seguridad"
  ],
